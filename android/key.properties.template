# Release Signing Configuration Template
# 
# INSTRUCTIONS:
# 1. Copy this file to 'key.properties' (remove .template extension)
# 2. Create a release keystore (see RELEASE_SIGNING_SETUP.md)
# 3. Fill in the values below with your actual keystore information
# 4. DO NOT commit key.properties to git (it's already in .gitignore)

storePassword=YOUR_STORE_PASSWORD_HERE
keyPassword=YOUR_KEY_PASSWORD_HERE
keyAlias=surah-yaseen-key
storeFile=../surah-yaseen-release-key.jks

# Example values (replace with your actual values):
# storePassword=MySecurePassword123!
# keyPassword=MySecureKeyPassword123!
